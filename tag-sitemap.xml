---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for tag in site.tags %}
  <url>
    <loc>{{ site.url }}/tag/{{ tag[0] | slugify }}/</loc>
    <lastmod>{{ tag[1].first.date | date_to_xmlschema }}</lastmod>
  </url>
{% endfor %}
</urlset>
