---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}{% assign skip = false %}{% if page.sitemap == false %}{% assign skip = true %}{% endif %}{% if page.url contains '/tag/' %}{% assign skip = true %}{% endif %}{% if page.url contains '/category/' %}{% assign skip = true %}{% endif %}{% if page.url contains 'sitemap' %}{% assign skip = true %}{% endif %}{% if page.url contains 'feed.xml' %}{% assign skip = true %}{% endif %}{% if page.url == '/404.html' %}{% assign skip = true %}{% endif %}{% if page.url contains 'BingSiteAuth' %}{% assign skip = true %}{% endif %}{% if page.url contains 'browserconfig' %}{% assign skip = true %}{% endif %}{% if page.url contains 'robots' %}{% assign skip = true %}{% endif %}{% unless skip %}
  <url>
    <loc>{{ site.url }}{{ page.url | replace: 'index.html', '' }}</loc>
  </url>
{% endunless %}{% endfor %}
</urlset>
