---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for category in site.categories %}
  <url>
    <loc>{{ site.url }}/category/{{ category[0] | slugify }}/</loc>
    <lastmod>{{ category[1].first.date | date_to_xmlschema }}</lastmod>
  </url>
{% endfor %}
</urlset>
